# Набор ключей должен совпадать с .env.local. Пустых значений не бывает:
#   not-required      — значение не нужно (код считает его незаданным)
#   required-not-set  — значение нужно, но ещё не получено
# Все переменные публичные — попадают в браузер.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Публичный VAPID-ключ: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
NEXT_PUBLIC_SCHOOL_NAME=Наша школа
# Для GitHub Pages: /имя-репозитория. Локально — not-required
NEXT_PUBLIC_BASE_PATH=not-required
